# Server
PORT=4000
NODE_ENV=development

# Database (Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/afturk?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Paystack
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxx"
PAYSTACK_WEBHOOK_SECRET="sk_test_xxxxxxxxxxxx"

# Business defaults (overridable via /admin/commission-rules)
DEFAULT_VENDOR_COMMISSION_RATE=0.20
DEFAULT_RIDER_COMMISSION_RATE=0.15
DEFAULT_SERVICE_FEE_FLAT=5
